#!/bin/sh
# XDM session for GNOME on NetBSD.

PATH="/usr/pkg/bin:/usr/pkg/sbin:/usr/X11R7/bin:/usr/bin:/bin"
export PATH

# Recommended by pkgsrc GNOME/mutter on NetBSD.
XCURSOR_PATH="/usr/pkg/share/icons"
export XCURSOR_PATH

# Swedish keyboard layout for X11.
setxkbmap se

# Current pkgsrc mixes GNOME Shell 40.2 with much newer GJS/GLib components.
# Use a GLib resource overlay containing small compatibility fixes without
# rebuilding the gnome-shell binary package.
G_RESOURCE_OVERLAYS="/org/gnome/shell=/usr/pkg/share/adjustkernel/gnome-shell-overlay"
export G_RESOURCE_OVERLAYS

# Keep JIT disabled while stabilising this old GNOME Shell/new GJS combination.
# Standalone GJS JIT tests pass, so this can be reconsidered after the shell is
# otherwise working reliably.
export GJS_DISABLE_JIT=1

# GNOME on NetBSD uses ConsoleKit rather than systemd-logind.
exec ck-launch-session gnome-session
